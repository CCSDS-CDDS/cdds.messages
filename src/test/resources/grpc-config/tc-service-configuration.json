{
  "$schema": "https://ccsds.org/cdds/v1/schemas/cdds-tc-service-configuration.schema.json",
  "gRpcServer": {
    "serviceProvider": "myProvider",
    "terminal": "myGroundStation",
    "address": "my-provider.example.com",
    "port": 8443,
    "rootCertificateFile": "cert/cdds-ca.pem",
    "certificateFile": "cert/cdds-user.pem",
    "privateKeyFile": "cert/cdds-user.key"
  },
  "endpoints": {
    "endpoints": [
      {
        "endpointName": "myGroundStation.mySpacecraft.tc.cltu",
        "serviceVersion": 1,
        "serviceProvider": "myProvider",
        "terminal": "myGroundStation",
        "serviceUser": "mySpacecraft",
        "cltu": true
      },
      {
        "endpointName": "myGroundStation.mySpacecraft.tc.vc0",
        "serviceVersion": 1,
        "serviceProvider": "myProvider",
        "terminal": "myGroundStation",
        "serviceUser": "mySpacecraft",
        "gvcIds": {
          "gvcId": [
            {
              "spacecraftId": "4711",
              "version": "USLP",
              "virtualChannelId": 0
            }
          ]
        }
      }
    ]
  }
}
