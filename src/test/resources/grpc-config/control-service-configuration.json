{
  "$schema": "https://ccsds.org/cdds/v1/schemas/cdds-control-service-configuration.schema.json",
  "gRpcServer": {
    "serviceProvider": "myProvider",
    "terminal": "myGroundStation",
    "address": "my-provider.example.com",
    "port": 8443,
    "rootCertificateFile": "cert/cdds-ca.pem",
    "certificateFile": "cert/cdds-user.pem",
    "privateKeyFile": "cert/cdds-user.key"
  },
  "endpoints": {
    "endpoints": [
      {
        "endpointName": "myGroundStation.mySpacecraft.ctl.fr-directives",
        "serviceVersion": 1,
        "serviceProvider": "myProvider",
        "terminal": "myGroundStation",
        "serviceUser": "mySpacecraft",
        "ackTimeout": 5,
        "functionalResourceDirectives": [
          {
            "functionalResourceDirective": {
              "oidString": "my.fr-directive-all-instances",
              "arcs": ["1", "2", "3", "6", "1"]
            }
          },
          {
            "functionalResourceDirective": {
              "oidString": "my.fr-directive-instance",
              "arcs": ["1", "2", "3", "6", "2"]
            },
            "functionalResourceInstance": "2"
          }
        ],
        "genericDirectiveIds": []
      },
      {
        "endpointName": "myGroundStation.mySpacecraft.ctl.generic-directives",
        "serviceVersion": 1,
        "serviceProvider": "myProvider",
        "terminal": "myGroundStation",
        "serviceUser": "mySpacecraft",
        "ackTimeout": 5,
        "functionalResourceDirectives": [],
        "genericDirectiveIds": ["my-generic-directive-one", "my-generic-directive-two"]
      }
    ]
  }
}
